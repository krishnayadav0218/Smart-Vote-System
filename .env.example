# Copy this file to .env and fill in real values before running docker-compose.
# Generate a strong secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Password for the auto-created "admin" account — CHANGE THIS, don't ship the default.
SEED_ADMIN_PASSWORD=
# Set to "true" once the whole app is served over HTTPS — makes the admin
# session cookie HTTPS-only. Keep "false" for local http:// testing.
COOKIE_SECURE=false
# "lax" if frontend+backend share a domain. "none" if they're on different
# domains (e.g. frontend on Vercel, backend on Render) — "none" REQUIRES
# COOKIE_SECURE=true or browsers will silently reject the login cookie.
COOKIE_SAMESITE=lax
# How long an admin login session stays valid before needing to log in again.
ADMIN_SESSION_HOURS=8
