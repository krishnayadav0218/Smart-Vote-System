# SmartVote — environment variables for Render
#
# HOW TO USE:
#   Render, like Vercel, does not read a committed .env file for security —
#   `render.yaml` in this repo already predefines most of these (see below),
#   but SECRETS still need to be typed into the Render dashboard yourself:
#   your service → Environment → Add Environment Variable.
#
# If you deploy via the included render.yaml ("New +" → "Blueprint" in the
# Render dashboard, point it at this repo), most of this is automatic. This
# file just lists what ends up where, and what you must fill in by hand.

# ============================================================
# BACKEND service (smartvote-backend) — set these in its Environment tab
# ============================================================

# Only secret you MUST set yourself — render.yaml marks it "sync: false" on
# purpose so a real password never gets committed to your repo.
SEED_ADMIN_PASSWORD=ChangeThisToSomethingStrong123!

# OPTIONAL — set any of these (in the backend service's Environment tab) to
# auto-create the other logins on next deploy/restart, instead of using
# Settings → "Admin panel logins" after logging in as admin. Leave any of
# these blank to skip that one — nothing breaks either way.
SEED_VOTER_MANAGER_PASSWORD=
SEED_VOTE_TRACKER_PASSWORD=
SEED_ELECTION_OFFICER_PASSWORD=
# Optional: override the auto-created username (defaults are voter_manager /
# vote_tracker / election_officer):
# SEED_VOTER_MANAGER_USERNAME=
# SEED_VOTE_TRACKER_USERNAME=
# SEED_ELECTION_OFFICER_USERNAME=

# render.yaml auto-generates this one for you (a random 64-char hex string).
# You never need to type it in — listed here only so you know it exists.
# SECRET_KEY=<auto-generated by Render>

# Update this AFTER your frontend service is created and you know its real
# https://xxxx.onrender.com URL (or your custom domain).
CORS_ORIGINS=https://smartvote-frontend.onrender.com

# Render serves everything over HTTPS, so keep these as-is:
COOKIE_SECURE=true
COOKIE_SAMESITE=none
ADMIN_SESSION_HOURS=8

# Default: a SQLite file on Render's persistent disk (paid plans only — see
# README "Deploying on Render" for why the free plan needs Postgres instead).
DATABASE_URL=sqlite:////data/smartvote.db
# Free-plan alternative — create a free Render Postgres instance, then paste
# its "Internal Connection String" here instead:
# DATABASE_URL=postgresql://user:password@host/dbname

# ============================================================
# FRONTEND service (smartvote-frontend) — set this in its Environment tab
# ============================================================

# Update this AFTER your backend service is created and you know its real
# https://xxxx.onrender.com URL.
VITE_API_URL=https://smartvote-backend.onrender.com

# ============================================================
# First-deploy chicken-and-egg note
# ============================================================
# You won't know either service's final onrender.com URL until after it's
# first deployed. Normal flow:
#   1. Deploy the Blueprint with the placeholder URLs above as-is.
#   2. Once both services are live, copy their real URLs from the Render
#      dashboard.
#   3. Update CORS_ORIGINS (backend) and VITE_API_URL (frontend) to the real
#      URLs, then trigger a redeploy on both (Render does this automatically
#      when you save an env var change).
