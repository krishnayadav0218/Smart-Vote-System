# ============================================================
# Paste this into: Render dashboard -> smartvote-backend service
#                   -> Environment tab -> "Add from .env" (paste this whole block)
# ============================================================
# Fill in the two lines marked FILL-IN before pasting. Everything else is
# ready to use as-is.

# A real random secret is already generated for you below — don't reuse it
# anywhere else, and don't share it.
SECRET_KEY=4fdff9f4decbc0164d9d1d2ee0b50096b63b9dc8c20e46239245c9b91b7e01e4

# FILL IN — this becomes the "admin" account's password. Change it after
# first login too (Settings -> Change admin password).
SEED_ADMIN_PASSWORD=ChangeThisToSomethingStrong123!

# FILL IN — your FRONTEND service's exact URL (from its Render page), e.g.:
# CORS_ORIGINS=https://smart-vote-system-z60g.onrender.com
CORS_ORIGINS=https://your-frontend-url.onrender.com

# Render serves everything over HTTPS, and frontend+backend are different
# *.onrender.com domains, so these two need to be exactly this:
COOKIE_SECURE=true
COOKIE_SAMESITE=none

ADMIN_SESSION_HOURS=8
DATABASE_URL=sqlite:////data/smartvote.db

# OPTIONAL — auto-create the other role logins (voter_manager, vote_tracker,
# election_officer) without touching the UI. Leave blank/delete the line to
# skip any of them.
SEED_VOTER_MANAGER_PASSWORD=
SEED_VOTE_TRACKER_PASSWORD=
SEED_ELECTION_OFFICER_PASSWORD=
